  "hubbard_u_validation": {
    "method": "Queried mp-api get_entries() for 15 random MP training compounds, inspected actual is_hubbard/hubbards fields on GGA/GGA+U-type entries. Every GGA+U entry's hubbards dict matched exactly the pymatgen MPRelaxSet LDAUU oxide table {Co,Cr,Fe,Mn,Mo,Ni,V,W}; every plain-GGA entry's A/B-site elements were outside that set. Rule confirmed empirically, not assumed.",
    "elements": [
      "Co",
      "Cr",
      "Fe",
      "Mn",
      "Mo",
      "Ni",
      "V",
      "W"
    ]
  },
